# Keep the distribution archive to what a consumer actually runs. Tests, fixtures, tools and the
# analyser config are for developing this package, not for sitting in someone's vendor/.
/tests               export-ignore
/tools               export-ignore
/phpstan.neon        export-ignore
/ecs.php             export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/composer.lock       export-ignore
/Makefile            export-ignore
/.github             export-ignore
